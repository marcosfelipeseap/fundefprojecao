<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        table th { background-color: #f1f5f9; text-transform: uppercase; font-size: 0.70rem; letter-spacing: 0.05em; color: #475569; padding: 10px; border: 1px solid #e2e8f0; }
        table td { padding: 10px; border: 1px solid #e2e8f0; font-size: 0.85rem; color: #1e293b; }
        table tbody tr:hover { background-color: #f8fafc; }
        .tab-btn.active { background-color: #2563eb; color: white; border-color: #2563eb; box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.4); }
        .tab-btn { background-color: #f8fafc; color: #64748b; border-color: #cbd5e1; }
        .item-checkbox:checked + span { background-color: #2563eb; color: white; border-color: #2563eb; }
        /* Oculta setinhas chatas do input number */
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    </style>
</head>
<body class="bg-slate-50 font-sans antialiased p-4 md:p-8">

    <div class="max-w-[1500px] mx-auto space-y-6">
        
        <!-- Cabeçalho & Navegação -->
        <div class="flex flex-col md:flex-row justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-slate-800"><i class="fa-solid fa-chart-line text-blue-600 mr-2"></i> <%= titulo %></h1>
                <p class="text-slate-500 mt-1">Selecione o agrupamento e o período desejado</p>
            </div>
            
            <div class="flex items-center space-x-6 mt-6 md:mt-0 flex-wrap gap-y-4 justify-end">
                <div class="flex space-x-2 bg-slate-100 p-1 rounded-lg border border-slate-200">
                    <button id="btnF1" onclick="setFundef(1)" class="tab-btn active px-6 py-2 rounded-md font-bold text-sm transition-all border">FUNDEF 1</button>
                    <button id="btnF2" onclick="setFundef(2)" class="tab-btn px-6 py-2 rounded-md font-bold text-sm transition-all border">FUNDEF 2</button>
                </div>

                <div class="flex space-x-2 items-center bg-slate-50 p-2 rounded-lg border border-slate-200 relative">
                    <div class="flex flex-col">
                        <label class="text-[10px] font-bold text-slate-400 uppercase">Data Inicial</label>
                        <input type="date" id="dataInicio" value="2026-08-15" class="px-2 py-1 bg-white border border-slate-300 rounded text-sm text-slate-700 outline-none">
                    </div>
                    <div class="flex flex-col">
                        <label class="text-[10px] font-bold text-slate-400 uppercase">Data Final</label>
                        <input type="date" id="dataFim" class="px-2 py-1 bg-white border border-slate-300 rounded text-sm text-slate-700 outline-none">
                    </div>
                    <div class="flex flex-col border-l border-slate-300 pl-2 ml-1">
                        <label class="text-[10px] font-bold text-slate-400 uppercase">Visão</label>
                        <select id="chartViewMode" onchange="updateAll(false)" class="px-2 py-1 bg-white border border-slate-300 rounded text-sm text-slate-700 outline-none font-semibold cursor-pointer">
                            <option value="acumulado">📈 Acumulada</option>
                            <option value="diario">📊 Por Dia</option>
                        </select>
                    </div>

                    <!-- BOTÕES DE EDIÇÃO TEMPORÁRIA -->
                    <div class="flex items-center space-x-1 border-l border-slate-300 pl-2 ml-1 h-full">
                        <button id="btnEdit" onclick="toggleEditMode()" class="px-3 py-1.5 bg-white border border-slate-300 rounded text-sm text-slate-700 font-bold hover:bg-slate-100 transition-colors shadow-sm">
                            ✏️ Editar Valores
                        </button>
                        <button id="btnReset" onclick="resetData()" class="hidden px-3 py-1.5 bg-red-50 border border-red-200 rounded text-sm text-red-600 font-bold hover:bg-red-100 transition-colors shadow-sm" title="Descartar edições e voltar ao original">
                            🔄 Resetar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <p class="text-xs text-center text-slate-400 mb-2">Nota: As edições feitas aqui são temporárias para simulação. Ao recarregar a página ou clicar em Resetar, os dados oficiais da planilha retornam.</p>
        <h2 class="text-center text-xl font-bold text-slate-700 mt-4 mb-2">Visão Geral: <span id="lblFundefMain" class="text-blue-600">FUNDEF 1</span></h2>

        <!-- KPIs GERAIS DO TOPO -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-xl shadow-sm border-l-4 border-l-orange-500">
                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wide">Total Solicitado</h3>
                <p class="text-3xl font-bold text-orange-700 mt-1" id="kpiSolNum">0</p>
                <div class="mt-2 text-[10px] sm:text-xs text-slate-500 flex justify-between">
                    <span>Orig: <b id="kpiSolOrig" class="text-slate-700">R$ 0</b></span>
                    <span>Reaj: <b id="kpiSolReaj" class="text-orange-600">R$ 0</b></span>
                </div>
            </div>
            <div class="bg-white p-5 rounded-xl shadow-sm border-l-4 border-l-blue-500">
                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wide">Total Produzido</h3>
                <p class="text-3xl font-bold text-blue-700 mt-1" id="kpiProdNum">0</p>
                <div class="mt-2 text-[10px] sm:text-xs text-slate-500 flex justify-between">
                    <span>Orig: <b id="kpiProdOrig" class="text-slate-700">R$ 0</b></span>
                    <span>Reaj: <b id="kpiProdReaj" class="text-blue-600">R$ 0</b></span>
                </div>
            </div>
            <div class="bg-white p-5 rounded-xl shadow-sm border-l-4 border-l-green-500">
                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wide">Total Entregue</h3>
                <p class="text-3xl font-bold text-green-700 mt-1" id="kpiEntNum">0</p>
                <div class="mt-2 text-[10px] sm:text-xs text-slate-500 flex justify-between">
                    <span>Orig: <b id="kpiEntOrig" class="text-slate-700">R$ 0</b></span>
                    <span>Reaj: <b id="kpiEntReaj" class="text-green-600">R$ 0</b></span>
                </div>
            </div>
            <div class="bg-white p-5 rounded-xl shadow-sm border-l-4 border-l-purple-500">
                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wide">Em Estoque</h3>
                <p class="text-3xl font-bold text-purple-700 mt-1" id="kpiEstNum">0</p>
                <div class="mt-2 text-[10px] sm:text-xs text-slate-500 flex justify-between">
                    <span>Orig: <b id="kpiEstOrig" class="text-slate-700">R$ 0</b></span>
                    <span>Reaj: <b id="kpiEstReaj" class="text-purple-600">R$ 0</b></span>
                </div>
            </div>
        </div>

        <!-- 4 GRÁFICOS GERAIS -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="text-sm font-bold text-slate-700 text-center mb-1">PRODUZIDO - Físico (Qtd)</h3>
                <div class="relative h-64"><canvas id="chartGeralProdQtd"></canvas></div>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="text-sm font-bold text-slate-700 text-center mb-1">PRODUZIDO - Financeiro (R$)</h3>
                <div class="relative h-64"><canvas id="chartGeralProdVal"></canvas></div>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="text-sm font-bold text-slate-700 text-center mb-1">ENTREGUE - Físico (Qtd)</h3>
                <div class="relative h-64"><canvas id="chartGeralEntQtd"></canvas></div>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="text-sm font-bold text-slate-700 text-center mb-1">ENTREGUE - Financeiro (R$)</h3>
                <div class="relative h-64"><canvas id="chartGeralEntVal"></canvas></div>
            </div>
        </div>

        <!-- TABELA FINANCEIRA EXECUTIVA -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mt-8" id="tabelaContainer">
            <div class="p-4 border-b border-slate-200 bg-slate-50 flex justify-between items-center transition-colors" id="tabelaHeaderUI">
                <h2 class="text-lg font-bold text-slate-800">Tabela de Valores Individuais - <span class="lblFundefTable text-blue-600">FUNDEF 1</span></h2>
                <span id="lblSimulacao" class="hidden text-xs font-bold text-white bg-blue-600 px-2 py-1 rounded-md animate-pulse">MODO SIMULAÇÃO ATIVO</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[1400px]">
                    <thead>
                        <tr>
                            <th rowspan="2" class="w-48 bg-slate-100">Produto / Item</th>
                            <th rowspan="2" class="text-center bg-slate-100 border-r-2 border-slate-300">Preço Unit.<br>(Orig / Reaj)</th>
                            <th colspan="3" class="text-center bg-orange-50 text-orange-800 border-r-2 border-slate-300">DEMANDA GERAL (TODO O PERÍODO)</th>
                            <th colspan="3" id="thProd" class="text-center bg-blue-50 text-blue-800 border-r-2 border-slate-300">PRODUZIDO</th>
                            <th colspan="3" id="thEnt" class="text-center bg-green-50 text-green-800 border-r-2 border-slate-300">ENTREGUE</th>
                            <th colspan="3" id="thEst" class="text-center bg-purple-50 text-purple-800">EM ESTOQUE</th>
                        </tr>
                        <tr>
                            <th class="text-center bg-orange-50">Solicitado</th>
                            <th class="text-center bg-emerald-50">Entregue Total</th>
                            <th class="text-center bg-red-50 border-r-2 border-slate-300">Pendente</th>
                            <th class="text-center bg-blue-50">Qtd</th><th class="text-center bg-blue-50">Val. Orig</th><th class="text-center bg-blue-50 border-r-2 border-slate-300">Val. Reaj</th>
                            <th class="text-center bg-green-50">Qtd</th><th class="text-center bg-green-50">Val. Orig</th><th class="text-center bg-green-50 border-r-2 border-slate-300">Val. Reaj</th>
                            <th class="text-center bg-purple-50">Qtd</th><th class="text-center bg-purple-50">Val. Orig</th><th class="text-center bg-purple-50">Val. Reaj</th>
                        </tr>
                    </thead>
                    <tbody id="tabelaBody"></tbody>
                    <tfoot class="bg-slate-200 text-slate-800 font-bold" id="tabelaFoot"></tfoot>
                </table>
            </div>
        </div>

        <!-- ANÁLISE ESPECÍFICA (GRÁFICOS) -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mt-8 mb-10">
            <h2 class="text-lg font-bold text-slate-800 mb-2"><i class="fa-solid fa-magnifying-glass text-blue-500 mr-2"></i> Análise Específica de Produtos</h2>
            <p class="text-sm text-slate-500 mb-4">Marque os produtos abaixo para gerar gráficos evolutivos isolados deles.</p>
            
            <div id="itemSelectors" class="flex flex-wrap gap-2 mb-6"></div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="border border-slate-100 rounded-xl p-3"><h4 class="text-center text-xs font-bold text-slate-500 mb-1">PRODUZIDO (Qtd)</h4><div class="relative h-56"><canvas id="chartSpecProdQtd"></canvas></div></div>
                <div class="border border-slate-100 rounded-xl p-3"><h4 class="text-center text-xs font-bold text-slate-500 mb-1">PRODUZIDO (R$)</h4><div class="relative h-56"><canvas id="chartSpecProdVal"></canvas></div></div>
                <div class="border border-slate-100 rounded-xl p-3"><h4 class="text-center text-xs font-bold text-slate-500 mb-1">ENTREGUE (Qtd)</h4><div class="relative h-56"><canvas id="chartSpecEntQtd"></canvas></div></div>
                <div class="border border-slate-100 rounded-xl p-3"><h4 class="text-center text-xs font-bold text-slate-500 mb-1">ENTREGUE (R$)</h4><div class="relative h-56"><canvas id="chartSpecEntVal"></canvas></div></div>
            </div>
        </div>

    </div>

    <script>
        Chart.register(ChartDataLabels);
        
        let originalData = []; // Backup imaculado da Planilha
        let rawData = [];      // Dados em uso / editáveis
        let activeFundef = 1;
        let charts = {};
        let isEditMode = false;
        
        document.getElementById('dataFim').value = new Date().toISOString().split('T')[0];
        const formatMoney = (val) => val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

        function parseBRDate(dateStr) {
            if(!dateStr || dateStr === 'S/D') return 0;
            let str = String(dateStr).trim().split(' ')[0];
            if(str.includes('/')) {
                const p = str.split('/');
                if(p.length === 3) return p[0].length === 4 ? new Date(p[0], p[1]-1, p[2]).getTime() : new Date(p[2], p[1]-1, p[0]).getTime();
            } else if(str.includes('-')) {
                const p = str.split('-');
                if(p.length === 3) return p[0].length === 4 ? new Date(p[0], p[1]-1, p[2]).getTime() : new Date(p[2], p[1]-1, p[0]).getTime();
            }
            return 0; 
        }

        async function init() {
            try {
                const response = await fetch('/api/dados');
                const fetched = await response.json();
                
                originalData = JSON.parse(JSON.stringify(fetched));
                rawData = JSON.parse(JSON.stringify(fetched));
                
                document.getElementById('dataInicio').addEventListener('change', () => updateAll(false));
                document.getElementById('dataFim').addEventListener('change', () => updateAll(false));
                
                updateAll(true);
            } catch (error) {
                console.error(error);
                alert("Erro ao ler dados da planilha.");
            }
        }

        // ==========================================
        // LÓGICA DE EDIÇÃO TEMPORÁRIA "WHAT-IF"
        // ==========================================
        window.toggleEditMode = function() {
            isEditMode = !isEditMode;
            const btnEdit = document.getElementById('btnEdit');
            
            if (isEditMode) {
                btnEdit.innerHTML = '✅ Concluir Edição';
                btnEdit.className = "px-3 py-1.5 bg-blue-600 border border-blue-700 rounded text-sm text-white font-bold hover:bg-blue-700 transition-colors shadow-md";
                document.getElementById('lblSimulacao').classList.remove('hidden');
                document.getElementById('tabelaHeaderUI').classList.replace('bg-slate-50', 'bg-blue-50');
            } else {
                btnEdit.innerHTML = '✏️ Editar Valores';
                btnEdit.className = "px-3 py-1.5 bg-white border border-slate-300 rounded text-sm text-slate-700 font-bold hover:bg-slate-100 transition-colors shadow-sm";
                document.getElementById('lblSimulacao').classList.add('hidden');
                document.getElementById('tabelaHeaderUI').classList.replace('bg-blue-50', 'bg-slate-50');
            }
            updateAll(false);
        };

        window.updateSim = function(matchKey, field, val) {
            let num = parseFloat(val);
            if(isNaN(num) || num < 0) num = 0;
            
            let item = rawData.find(d => d.matchKey === matchKey);
            if(item) {
                // Se a edição for de Quantidade Produzida/Entregue, nós sobreescrevemos o histórico inteiro
                // e jogamos esse número como um "evento único" na data final do filtro atual.
                if (field === 'eventos_producao' || field === 'eventos_entrega') {
                    let dFimStr = document.getElementById('dataFim').value;
                    item[field] = [{ data: dFimStr, qtd: num }];
                } else {
                    item[field] = num;
                }
                document.getElementById('btnReset').classList.remove('hidden'); 
                updateAll(false);
            }
        };

        window.resetData = function() {
            rawData = JSON.parse(JSON.stringify(originalData));
            isEditMode = false;
            
            const btnEdit = document.getElementById('btnEdit');
            btnEdit.innerHTML = '✏️ Editar Valores';
            btnEdit.className = "px-3 py-1.5 bg-white border border-slate-300 rounded text-sm text-slate-700 font-bold hover:bg-slate-100 transition-colors shadow-sm";
            document.getElementById('lblSimulacao').classList.add('hidden');
            document.getElementById('tabelaHeaderUI').classList.replace('bg-blue-50', 'bg-slate-50');
            document.getElementById('btnReset').classList.add('hidden');
            
            updateAll(false);
        };

        window.setFundef = function(fNum) {
            activeFundef = fNum;
            document.getElementById('btnF1').className = fNum === 1 ? 'tab-btn active px-6 py-2 rounded-md font-bold text-sm transition-all border' : 'tab-btn px-6 py-2 rounded-md font-bold text-sm transition-all border';
            document.getElementById('btnF2').className = fNum === 2 ? 'tab-btn active px-6 py-2 rounded-md font-bold text-sm transition-all border' : 'tab-btn px-6 py-2 rounded-md font-bold text-sm transition-all border';
            
            document.getElementById('lblFundefMain').innerText = `FUNDEF ${fNum}`;
            document.querySelector('.lblFundefTable').innerText = `FUNDEF ${fNum}`;
            
            updateAll(true);
        };

        function updateAll(rebuildSelectors = false) {
            if(!rawData.length) return;
            const tsStart = new Date(document.getElementById('dataInicio').value + "T00:00:00").getTime();
            const tsEnd = new Date(document.getElementById('dataFim').value + "T23:59:59").getTime();
            const fData = rawData.filter(d => d.fundef === activeFundef);

            updateTableAndKPIs(fData, tsStart, tsEnd);
            const timelineGeral = buildTimeline(fData, tsStart, tsEnd);
            render4Charts(timelineGeral, 'Geral');

            if (rebuildSelectors) {
                const container = document.getElementById('itemSelectors');
                container.innerHTML = '';
                fData.forEach((d, i) => {
                    const chk = i === 0 ? 'checked' : '';
                    container.innerHTML += `
                        <label class="cursor-pointer">
                            <input type="checkbox" value="${d.matchKey}" ${chk} class="item-checkbox hidden" onchange="updateSpecCharts()">
                            <span class="px-3 py-1.5 rounded-full border border-slate-300 text-xs font-semibold text-slate-600 transition-colors inline-block shadow-sm select-none">${d.item}</span>
                        </label>
                    `;
                });
            }
            updateSpecCharts();
        }

        window.updateSpecCharts = function() {
            const selectedKeys = Array.from(document.querySelectorAll('.item-checkbox:checked')).map(cb => cb.value);
            const tsStart = new Date(document.getElementById('dataInicio').value + "T00:00:00").getTime();
            const tsEnd = new Date(document.getElementById('dataFim').value + "T23:59:59").getTime();
            
            const specData = rawData.filter(d => selectedKeys.includes(d.matchKey));
            const timelineSpec = buildTimeline(specData, tsStart, tsEnd);
            render4Charts(timelineSpec, 'Spec');
        };

        function buildTimeline(dataArr, tsStart, tsEnd) {
            const map = {};
            dataArr.forEach(item => {
                item.eventos_producao.forEach(e => {
                    const ts = parseBRDate(e.data);
                    if (ts === 0 || (ts >= tsStart && ts <= tsEnd)) {
                        const dStr = (ts === 0) ? 'Sem Data' : e.data;
                        const effectiveTs = (ts === 0) ? tsStart - 1 : ts; 
                        if (!map[dStr]) map[dStr] = { ts: effectiveTs, pQtd: 0, pOrig: 0, pReaj: 0, eQtd: 0, eOrig: 0, eReaj: 0 };
                        map[dStr].pQtd += e.qtd; map[dStr].pOrig += (e.qtd * item.preco_orig); map[dStr].pReaj += (e.qtd * item.preco_reaj);
                    }
                });
                item.eventos_entrega.forEach(e => {
                    const ts = parseBRDate(e.data);
                    if (ts === 0 || (ts >= tsStart && ts <= tsEnd)) {
                        const dStr = (ts === 0) ? 'Sem Data' : e.data;
                        const effectiveTs = (ts === 0) ? tsStart - 1 : ts; 
                        if (!map[dStr]) map[dStr] = { ts: effectiveTs, pQtd: 0, pOrig: 0, pReaj: 0, eQtd: 0, eOrig: 0, eReaj: 0 };
                        map[dStr].eQtd += e.qtd; map[dStr].eOrig += (e.qtd * item.preco_orig); map[dStr].eReaj += (e.qtd * item.preco_reaj);
                    }
                });
            });

            let arr = Object.values(map).sort((a,b) => a.ts - b.ts);
            let acc = { pQ:0, pO:0, pR:0, eQ:0, eO:0, eR:0 };
            
            let timeline = arr.map(t => {
                acc.pQ += t.pQtd; acc.pO += t.pOrig; acc.pR += t.pReaj;
                acc.eQ += t.eQtd; acc.eO += t.eOrig; acc.eR += t.eReaj;
                return {
                    date: t.ts < tsStart ? 'Sem Data' : new Date(t.ts).toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit'}),
                    pQtdDaily: t.pQtd, pOrigDaily: t.pOrig, pReajDaily: t.pReaj, eQtdDaily: t.eQtd, eOrigDaily: t.eOrig, eReajDaily: t.eReaj,
                    pQtdAcum: acc.pQ, pOrigAcum: acc.pO, pReajAcum: acc.pR, eQtdAcum: acc.eQ, eOrigAcum: acc.eO, eReajAcum: acc.eR
                };
            });
            return timeline.length ? timeline : [{ date: 'Sem Dados', pQtdDaily:0, pQtdAcum:0, pOrigDaily:0, pOrigAcum:0, pReajDaily:0, pReajAcum:0, eQtdDaily:0, eQtdAcum:0, eOrigDaily:0, eOrigAcum:0, eReajDaily:0, eReajAcum:0 }];
        }

        function render4Charts(timeline, prefix) {
            const labels = timeline.map(t => t.date);
            const isAcum = document.getElementById('chartViewMode').value === 'acumulado';
            const suffix = isAcum ? '(Acumulado)' : '(Por Dia)';

            drawLineChart(`chart${prefix}ProdQtd`, labels, [
                { label: `Qtd Produzida ${suffix}`, data: timeline.map(t => isAcum ? t.pQtdAcum : t.pQtdDaily), borderColor: '#3b82f6', bg: 'rgba(59, 130, 246, 0.1)' }
            ], 'num', isAcum);
            drawLineChart(`chart${prefix}ProdVal`, labels, [
                { label: `Val. Reajustado`, data: timeline.map(t => isAcum ? t.pReajAcum : t.pReajDaily), borderColor: '#4f46e5', bg: 'transparent' },
                { label: `Val. Original`, data: timeline.map(t => isAcum ? t.pOrigAcum : t.pOrigDaily), borderColor: '#94a3b8', bg: 'transparent', dash: [5,5] }
            ], 'val', isAcum);
            drawLineChart(`chart${prefix}EntQtd`, labels, [
                { label: `Qtd Entregue ${suffix}`, data: timeline.map(t => isAcum ? t.eQtdAcum : t.eQtdDaily), borderColor: '#10b981', bg: 'rgba(16, 185, 129, 0.1)' }
            ], 'num', isAcum);
            drawLineChart(`chart${prefix}EntVal`, labels, [
                { label: `Val. Reajustado`, data: timeline.map(t => isAcum ? t.eReajAcum : t.eReajDaily), borderColor: '#059669', bg: 'transparent' },
                { label: `Val. Original`, data: timeline.map(t => isAcum ? t.eOrigAcum : t.eOrigDaily), borderColor: '#94a3b8', bg: 'transparent', dash: [5,5] }
            ], 'val', isAcum);
        }

        function drawLineChart(id, labels, datasetsConfig, type, isAcum) {
            const ctx = document.getElementById(id).getContext('2d');
            if(charts[id]) charts[id].destroy();

            const chartType = isAcum ? 'line' : 'bar';
            
            const datasets = datasetsConfig.map(cfg => ({
                type: chartType, label: cfg.label, data: cfg.data, borderColor: cfg.borderColor,
                backgroundColor: chartType === 'bar' ? cfg.borderColor : cfg.bg, 
                borderWidth: chartType === 'bar' ? 0 : 2, fill: cfg.bg !== 'transparent',
                tension: 0.2, pointRadius: 3, borderDash: cfg.dash || [], borderRadius: chartType === 'bar' ? 4 : 0
            }));

            charts[id] = new Chart(ctx, {
                type: chartType,
                data: { labels, datasets },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    layout: { padding: { top: 15, bottom: 5 } },
                    plugins: { 
                        legend: { position: 'top', labels: {boxWidth: 10, font: {size: 10}} },
                        datalabels: {
                            align: (context) => chartType === 'line' ? (context.datasetIndex === 0 ? 'top' : 'bottom') : 'top',
                            anchor: 'end', offset: 4, font: {size: 9, weight: 'bold'}, 
                            color: (context) => context.dataset.borderColor, 
                            formatter: (v, context) => {
                                if (!v || v <= 0) return ''; 
                                if (chartType === 'line' && context.datasetIndex === 1) {
                                    const outroValor = context.chart.data.datasets[0].data[context.dataIndex];
                                    if (v === outroValor) return ''; 
                                }
                                if (type === 'val') {
                                    if (v >= 1000000) return 'R$ ' + (v/1000000).toFixed(1).replace('.',',') + 'M';
                                    return 'R$ ' + (v/1000).toFixed(0) + 'k';
                                }
                                return v.toLocaleString('pt-BR') + (chartType === 'line' ? '' : ' un');
                            }
                        }
                    },
                    scales: { 
                        x: { ticks: { font: {size: 9} } },
                        y: { ticks: { font: {size: 9}, callback: (v) => type === 'val' ? 'R$ '+(v/1000).toFixed(0)+'k' : v } }
                    }
                }
            });
        }

        // Tabela Financeira com TODOS os Inputs liberados
        function updateTableAndKPIs(fData, tsStart, tsEnd) {
            const dIn = document.getElementById('dataInicio').value.split('-').reverse().join('/');
            const dOut = document.getElementById('dataFim').value.split('-').reverse().join('/');
            document.getElementById('thProd').innerText = `PRODUZIDO (${dIn} a ${dOut})`;
            document.getElementById('thEnt').innerText = `ENTREGUE (${dIn} a ${dOut})`;
            document.getElementById('thEst').innerText = `EM ESTOQUE (Até ${dOut})`;

            let sums = { sQ:0, sO:0, sR:0, eTot:0, eTotO:0, eTotR:0, fQ:0, fO:0, fR:0, pQ:0, pO:0, pR:0, eQ:0, eO:0, eR:0, estQ:0, estO:0, estR:0 };
            const tbody = document.getElementById('tabelaBody');
            tbody.innerHTML = '';

            fData.forEach(d => {
                let pQtd = 0, eQtd = 0, eQtdTotal = 0;
                
                d.eventos_producao.forEach(e => { 
                    const ts = parseBRDate(e.data);
                    if(ts === 0 || (ts >= tsStart && ts <= tsEnd)) pQtd += e.qtd; 
                });
                
                d.eventos_entrega.forEach(e => { 
                    eQtdTotal += e.qtd; 
                    const ts = parseBRDate(e.data);
                    if(ts === 0 || (ts >= tsStart && ts <= tsEnd)) eQtd += e.qtd; 
                });

                let faltante = d.qtd_solicitada - eQtdTotal;
                if(faltante < 0) faltante = 0;

                const rowVals = {
                    sQ: d.qtd_solicitada, sO: d.qtd_solicitada * d.preco_orig, sR: d.qtd_solicitada * d.preco_reaj,
                    eTot: eQtdTotal, eTotO: eQtdTotal * d.preco_orig, eTotR: eQtdTotal * d.preco_reaj,
                    fQ: faltante, fO: faltante * d.preco_orig, fR: faltante * d.preco_reaj,
                    pQ: pQtd, pO: pQtd * d.preco_orig, pR: pQtd * d.preco_reaj,
                    eQ: eQtd, eO: eQtd * d.preco_orig, eR: eQtd * d.preco_reaj,
                    estQ: d.estoque_total, estO: d.estoque_total * d.preco_orig, estR: d.estoque_total * d.preco_reaj
                };

                ['sQ','sO','sR','eTot','eTotO','eTotR','fQ','fO','fR','pQ','pO','pR','eQ','eO','eR','estQ','estO','estR'].forEach(k => sums[k] += rowVals[k]);

                // 1. PREÇOS
                const tdPrecoHtml = isEditMode 
                    ? `<div class="flex flex-col gap-1 items-center">
                        <input type="number" step="0.01" class="w-20 text-center border border-slate-300 rounded text-xs p-1 text-slate-600 focus:outline-none focus:border-blue-500 bg-white shadow-inner" value="${d.preco_orig.toFixed(2)}" onchange="updateSim('${d.matchKey}', 'preco_orig', this.value)" title="Preço Original">
                        <input type="number" step="0.01" class="w-20 text-center border border-blue-300 rounded text-xs p-1 font-bold text-slate-800 bg-blue-50 focus:outline-none focus:border-blue-500 shadow-inner" value="${d.preco_reaj.toFixed(2)}" onchange="updateSim('${d.matchKey}', 'preco_reaj', this.value)" title="Preço Reajustado">
                       </div>`
                    : `<span class="text-slate-500">${formatMoney(d.preco_orig)}</span><br><b class="text-slate-800">${formatMoney(d.preco_reaj)}</b>`;

                // 2. SOLICITADO
                const tdSolHtml = isEditMode
                    ? `<input type="number" step="1" class="w-20 text-center border border-orange-400 rounded text-sm p-1 font-bold text-orange-700 focus:outline-none focus:border-orange-500 shadow-inner bg-white" value="${rowVals.sQ}" onchange="updateSim('${d.matchKey}', 'qtd_solicitada', this.value)" title="Quantidade Solicitada">`
                    : `${rowVals.sQ.toLocaleString('pt-BR')} un`;

                // 3. PRODUZIDO
                const tdProdQtdHtml = isEditMode
                    ? `<input type="number" step="1" class="w-20 text-center border border-blue-400 rounded text-sm p-1 font-bold text-blue-700 focus:outline-none focus:border-blue-500 shadow-inner bg-white" value="${rowVals.pQ}" onchange="updateSim('${d.matchKey}', 'eventos_producao', this.value)" title="Simular Quantidade Produzida">`
                    : `${rowVals.pQ.toLocaleString('pt-BR')}`;

                // 4. ENTREGUE
                const tdEntQtdHtml = isEditMode
                    ? `<input type="number" step="1" class="w-20 text-center border border-green-400 rounded text-sm p-1 font-bold text-green-700 focus:outline-none focus:border-green-500 shadow-inner bg-white" value="${rowVals.eQ}" onchange="updateSim('${d.matchKey}', 'eventos_entrega', this.value)" title="Simular Quantidade Entregue">`
                    : `${rowVals.eQ.toLocaleString('pt-BR')}`;

                // 5. ESTOQUE
                const tdEstoqueHtml = isEditMode
                    ? `<input type="number" step="1" class="w-20 text-center border border-purple-400 rounded text-sm p-1 font-bold text-purple-700 focus:outline-none focus:border-purple-500 shadow-inner bg-white" value="${rowVals.estQ}" onchange="updateSim('${d.matchKey}', 'estoque_total', this.value)" title="Simular Estoque">`
                    : `${rowVals.estQ.toLocaleString('pt-BR')}`;

                tbody.innerHTML += `
                    <tr>
                        <td class="font-semibold text-slate-700 text-xs">${d.item}</td>
                        <td class="text-center border-r-2 border-slate-300 align-middle">
                            ${tdPrecoHtml}
                        </td>
                        
                        <td class="text-center bg-orange-50/50 align-middle">
                            <div class="font-bold text-orange-700 text-sm flex justify-center">${tdSolHtml}</div>
                            <div class="text-[10px] text-slate-500 font-normal mt-1">Orig: ${formatMoney(rowVals.sO)}</div>
                            <div class="text-[10px] text-orange-600 font-semibold">Reaj: ${formatMoney(rowVals.sR)}</div>
                        </td>
                        <td class="text-center bg-emerald-50/50 align-middle">
                            <div class="font-bold text-emerald-700 text-sm">${rowVals.eTot.toLocaleString('pt-BR')} un</div>
                            <div class="text-[10px] text-slate-500 font-normal mt-1">Orig: ${formatMoney(rowVals.eTotO)}</div>
                            <div class="text-[10px] text-emerald-600 font-semibold">Reaj: ${formatMoney(rowVals.eTotR)}</div>
                        </td>
                        <td class="text-center bg-red-50/50 border-r-2 border-slate-300 align-middle">
                            <div class="font-bold text-red-600 text-sm">${rowVals.fQ.toLocaleString('pt-BR')} un</div>
                            <div class="text-[10px] text-slate-500 font-normal mt-1">Orig: ${formatMoney(rowVals.fO)}</div>
                            <div class="text-[10px] text-red-500 font-semibold">Reaj: ${formatMoney(rowVals.fR)}</div>
                        </td>

                        <td class="text-center font-bold text-blue-700 bg-blue-50/30 align-middle">${tdProdQtdHtml}</td>
                        <td class="text-center text-slate-500 bg-blue-50/30 text-[11px] align-middle">${formatMoney(rowVals.pO)}</td>
                        <td class="text-center text-blue-600 bg-blue-50/30 font-semibold border-r-2 border-slate-300 text-[11px] align-middle">${formatMoney(rowVals.pR)}</td>
                        
                        <td class="text-center font-bold text-green-700 bg-green-50/30 align-middle">${tdEntQtdHtml}</td>
                        <td class="text-center text-slate-500 bg-green-50/30 text-[11px] align-middle">${formatMoney(rowVals.eO)}</td>
                        <td class="text-center text-green-600 bg-green-50/30 font-semibold border-r-2 border-slate-300 text-[11px] align-middle">${formatMoney(rowVals.eR)}</td>
                        
                        <td class="text-center font-bold text-purple-700 bg-purple-50/30 align-middle">${tdEstoqueHtml}</td>
                        <td class="text-center text-slate-500 bg-purple-50/30 text-[11px] align-middle">${formatMoney(rowVals.estO)}</td>
                        <td class="text-center text-purple-600 bg-purple-50/30 font-semibold text-[11px] align-middle">${formatMoney(rowVals.estR)}</td>
                    </tr>
                `;
            });

            document.getElementById('tabelaFoot').innerHTML = `
                <tr>
                    <td colspan="2" class="text-right p-3 border-r-2 border-slate-300">TOTAIS (FUNDEF ${activeFundef}):</td>
                    
                    <td class="text-center bg-orange-200">
                        <div class="text-sm text-slate-800">${sums.sQ.toLocaleString('pt-BR')} un</div>
                        <div class="text-[10px] text-slate-600 font-normal">O: ${formatMoney(sums.sO)}</div>
                        <div class="text-[10px] text-orange-800">R: ${formatMoney(sums.sR)}</div>
                    </td>
                    <td class="text-center bg-emerald-200">
                        <div class="text-sm text-slate-800">${sums.eTot.toLocaleString('pt-BR')} un</div>
                        <div class="text-[10px] text-slate-600 font-normal">O: ${formatMoney(sums.eTotO)}</div>
                        <div class="text-[10px] text-emerald-800">R: ${formatMoney(sums.eTotR)}</div>
                    </td>
                    <td class="text-center bg-red-200 border-r-2 border-slate-300">
                        <div class="text-sm text-slate-800">${sums.fQ.toLocaleString('pt-BR')} un</div>
                        <div class="text-[10px] text-slate-600 font-normal">O: ${formatMoney(sums.fO)}</div>
                        <div class="text-[10px] text-red-800">R: ${formatMoney(sums.fR)}</div>
                    </td>

                    <td class="text-center bg-blue-200 text-sm text-slate-800">${sums.pQ.toLocaleString('pt-BR')}</td>
                    <td class="text-center bg-blue-200 font-normal text-[10px] text-slate-600">${formatMoney(sums.pO)}</td>
                    <td class="text-center bg-blue-200 border-r-2 border-slate-300 text-[10px] text-blue-800">${formatMoney(sums.pR)}</td>
                    
                    <td class="text-center bg-green-200 text-sm text-slate-800">${sums.eQ.toLocaleString('pt-BR')}</td>
                    <td class="text-center bg-green-200 font-normal text-[10px] text-slate-600">${formatMoney(sums.eO)}</td>
                    <td class="text-center bg-green-200 border-r-2 border-slate-300 text-[10px] text-green-800">${formatMoney(sums.eR)}</td>
                    
                    <td class="text-center bg-purple-200 text-sm text-slate-800">${sums.estQ.toLocaleString('pt-BR')}</td>
                    <td class="text-center bg-purple-200 font-normal text-[10px] text-slate-600">${formatMoney(sums.estO)}</td>
                    <td class="text-center bg-purple-200 text-[10px] text-purple-800">${formatMoney(sums.estR)}</td>
                </tr>
            `;

            document.getElementById('kpiSolNum').innerText = sums.sQ.toLocaleString('pt-BR') + ' un';
            document.getElementById('kpiSolOrig').innerText = formatMoney(sums.sO);
            document.getElementById('kpiSolReaj').innerText = formatMoney(sums.sR);
            document.getElementById('kpiProdNum').innerText = sums.pQ.toLocaleString('pt-BR') + ' un';
            document.getElementById('kpiProdOrig').innerText = formatMoney(sums.pO);
            document.getElementById('kpiProdReaj').innerText = formatMoney(sums.pR);
            document.getElementById('kpiEntNum').innerText = sums.eQ.toLocaleString('pt-BR') + ' un';
            document.getElementById('kpiEntOrig').innerText = formatMoney(sums.eO);
            document.getElementById('kpiEntReaj').innerText = formatMoney(sums.eR);
            document.getElementById('kpiEstNum').innerText = sums.estQ.toLocaleString('pt-BR') + ' un';
            document.getElementById('kpiEstOrig').innerText = formatMoney(sums.estO);
            document.getElementById('kpiEstReaj').innerText = formatMoney(sums.estR);
        }

        init();
    </script>
</body>
</html>