<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  <!-- Tailwind e FontAwesome para o cabeçalho novo -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    /* VARIAVEIS ORIGINAIS DO SEU SIMULADOR */
    :root {
      --primary: #2c3e50; --secondary: #34495e; --accent: #3498db;
      --success: #27ae60; --danger: #e74c3c; --bg: #f8f9fa;
      --border: #dee2e6; --main-insumo: #eaf2f8; --other-insumo: #fdfefe;
    }
    
    body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; margin: 0; background: var(--bg); color: #333; }
    
    .btn { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; transition: background 0.2s; font-size: 13px; }
    .btn-reset { background: var(--danger); color: white; }
    .btn-reset:hover { background: #c0392b; }
    .btn-filter { background: var(--secondary); color: white; margin-right: 10px; }
    .btn-filter:hover { background: #2c3e50; }
    .btn-calc { background: var(--accent); color: white; font-size: 9px; padding: 2px 6px; border-radius: 3px; margin-top: 4px; cursor: pointer; border: none; }
    .btn-calc:hover { background: #2980b9; }

    /* DASHBOARD TOPO */
    .dashboard-header { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 25px; }
    .dashboard-header .card { padding: 25px; border-radius: 8px; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.08); border-bottom: 6px solid; background: #fff; }
    .dashboard-header .card h4 { margin: 0 0 10px 0; font-size: 15px; text-transform: uppercase; letter-spacing: 1px; color: #555; }
    .dashboard-header .card .val { font-size: 32px; font-weight: bold; }
    .card-pos-total { border-color: var(--success); }
    .card-pos-total .val { color: var(--success); }
    .card-neg-total { border-color: var(--danger); }
    .card-neg-total .val { color: var(--danger); }

    /* Tabela */
    .table-container { background: #fff; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border-radius: 8px; margin-bottom: 30px; overflow-x: auto; }
    table { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 12px; }
    th, td { border-bottom: 1px solid var(--border); border-right: 1px solid var(--border); padding: 8px; text-align: center; white-space: nowrap; }
    td { background: white; }
    
    /* Cabeçalhos Fixos */
    thead th { background: var(--primary); color: #fff; position: sticky; top: 0; z-index: 10; font-weight: 500; border-right: 1px solid #455a64; }
    thead tr:nth-child(2) th { top: 35px; } 
    
    .col-tipo { min-width: 130px; white-space: normal; }
    .col-produto { min-width: 180px; white-space: normal; }
    
    .insumo-main { background-color: var(--main-insumo); }
    .insumo-other { background-color: var(--other-insumo); }
    .separator { background: #95a5a6 !important; width: 3px; padding: 0 !important; min-width: 3px; border: none; }
    
    .calc-row th { background: #ecf0f1; color: var(--primary); text-align: right; font-weight: bold; }
    .calc-row td { background: #fdfdfd; }
    
    .edit-input { width: 100%; box-sizing: border-box; border: 1px dashed transparent; background: transparent; text-align: center; font-family: inherit; font-size: inherit; color: inherit; padding: 4px; outline: none; border-radius: 3px; transition: 0.2s; }
    .edit-input:hover { border-color: #bdc3c7; }
    .edit-input:focus { background: #fff; border: 1px solid var(--accent); box-shadow: 0 0 4px rgba(52, 152, 219, 0.3); }
    .text-left { text-align: left; }
    
    .val-box { font-size: 10px; color: #7f8c8d; margin-top: 4px; }
    .bold { font-weight: bold; }
    .saldo-pos { color: var(--success); font-weight: bold; }
    .saldo-neg { color: var(--danger); font-weight: bold; }
    
    .row-disabled td { opacity: 0.4; background: #f4f4f4; }
    tbody tr:hover td { filter: brightness(0.96); }
    .loading { font-size: 18px; color: #555; padding: 40px; text-align: center; font-weight: bold; }

    .check-col { width: 30px; min-width: 30px; }
    input[type="checkbox"] { cursor: pointer; width: 16px; height: 16px; }

    /* DASHBOARD RODAPÉ */
    .dashboard-footer { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-top: 40px; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); margin-bottom: 50px; }
    .dashboard-footer .card { padding: 15px; border-radius: 6px; border-left: 5px solid; background: #fdfdfd; }
    .dashboard-footer .card h4 { margin: 0 0 5px 0; font-size: 12px; color: #7f8c8d; text-transform: uppercase; }
    .dashboard-footer .card .val { font-size: 20px; font-weight: bold; margin-top: 8px; }
    
    .card-pos-main { border-color: var(--success); }
    .card-neg-main { border-color: var(--danger); }
    .card-neg-main .val { color: var(--danger); }
    .card-pos-other { border-color: #2ecc71; }
    .card-neg-other { border-color: #e67e22; }
    .card-neg-other .val { color: #e67e22; }

    /* Modal */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; z-index: 9999; }
    .modal-content { background: white; padding: 20px; border-radius: 8px; width: 500px; max-width: 90%; max-height: 80vh; overflow-y: auto; box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 2px solid var(--border); padding-bottom: 10px; }
    .modal-header h3 { margin: 0; color: var(--primary); }
    .close-btn { background: none; border: none; font-size: 20px; cursor: pointer; color: #7f8c8d; }
    .calc-list { width: 100%; border-collapse: collapse; }
    .calc-list th, .calc-list td { border: 1px solid #eee; padding: 6px; font-size: 12px; text-align: left; }
    .modal-total { font-size: 16px; font-weight: bold; text-align: right; margin-top: 15px; color: var(--primary); }
  </style>
</head>
<body class="p-4 md:p-8">

  <div id="app" class="max-w-[1500px] mx-auto space-y-6">
    
    <!-- Cabeçalho unificado com Tailwind -->
    <div class="flex flex-col md:flex-row justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mb-6">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-slate-800"><i class="fa-solid fa-calculator text-indigo-600 mr-2"></i> <%= titulo %></h1>
            <p class="text-slate-500 mt-1">Cálculo preditivo de compra e alocação de insumos</p>
        </div>
        
        <div class="mt-6 md:mt-0 flex space-x-3">
            <a href="/" class="bg-slate-100 text-slate-700 px-5 py-2.5 rounded-lg font-bold text-sm hover:bg-slate-200 transition-colors shadow-sm border border-slate-300 flex items-center">
                <i class="fa-solid fa-chart-line mr-2"></i> Dashboard
            </a>
            <a href="/projecao" class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-bold text-sm hover:bg-indigo-700 transition-colors shadow-md border border-indigo-700 flex items-center">
                <i class="fa-solid fa-calendar-days mr-2"></i> Ver Projeção
            </a>
        </div>
    </div>

    <div v-if="loading" class="loading">Sincronizando com a Planilha via Node.js...</div>
    <div v-else>
      <div style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
        <button class="btn btn-filter" @click="mostrarTodos = !mostrarTodos">
          {{ mostrarTodos ? 'Ocultar Produtos Zerados' : 'Mostrar Todos os Produtos' }}
        </button>
        <button class="btn btn-reset" @click="resetData">↺ Resetar Dados Originais</button>
      </div>

      <!-- DASHBOARD TOPO -->
      <div class="dashboard-header">
        <div class="card card-pos-total">
          <h4>Total Saldo Positivo</h4>
          <div class="val">{{ formatCurrency(summary.saldoPosTotal) }}</div>
        </div>
        <div class="card card-neg-total">
          <h4>A Solicitar (Falta Comprar / Negativos)</h4>
          <div class="val">{{ formatCurrency(summary.aSolicitarTotal) }}</div>
        </div>
      </div>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th rowspan="2" class="check-col">
                <input type="checkbox" :checked="allSelected" @change="toggleAll" title="Selecionar Todos Visíveis">
              </th>
              <th colspan="8">Informações dos Produtos</th>
              <th>VALOR TOTAL</th>
              <th class="separator"></th>
              <th :colspan="insumosMain.length">Insumos (Maior Relevância)</th>
              <th class="separator"></th>
              <th :colspan="insumosOther.length">Outros Insumos</th>
            </tr>
            <tr>
              <th v-for="h in headers.slice(0, 8)" :key="h">{{ h }}</th>
              <th>(QNTD × VALOR)</th> 
              <th class="separator"></th>
              <th v-for="ins in insumosMain" :key="ins.idx">{{ ins.name }}</th>
              <th class="separator"></th>
              <th v-for="ins in insumosOther" :key="ins.idx">{{ ins.name }}</th>
            </tr>
          </thead>
          <tbody>
            <!-- Produtos renderizados de forma condicional pelo filtro -->
            <tr v-for="prod in displayedProducts" :key="prod.id" :class="{'row-disabled': !prod.selected}">
              <td><input type="checkbox" v-model="prod.selected"></td>
              <td class="col-tipo"><input class="edit-input text-left" v-model="prod.tipo"></td>
              <td class="col-produto"><input class="edit-input text-left" v-model="prod.produto"></td>
              <td><input class="edit-input" :value="formatNum(prod.conveniada)" @blur="updateField(prod, 'conveniada', $event)"></td>
              <td><input class="edit-input" :value="formatNum(prod.entregue)" @blur="updateField(prod, 'entregue', $event)"></td>
              <td><input class="edit-input" :value="formatNum(prod.faltante)" @blur="updateField(prod, 'faltante', $event)"></td>
              <td><input class="edit-input" :value="formatNum(prod.estoque)" @blur="updateField(prod, 'estoque', $event)"></td>
              
              <!-- QNTD A ENTREGAR -->
              <td style="background:#f9f9f9;">
                <input class="edit-input bold" :value="formatNum(prod.qntdEntregar)" @blur="updateField(prod, 'qntdEntregar', $event)">
              </td>
              
              <td><input class="edit-input" :value="formatCurrency(prod.valorProduto)" @blur="updateField(prod, 'valorProduto', $event, true)"></td>
              <td class="bold" style="background:#f9f9f9; color:var(--accent);">{{ formatCurrency(calcValorTotalProduto(prod)) }}</td>
              
              <td class="separator"></td>
              <td v-for="ins in insumosMain" :key="ins.idx" class="insumo-main">
                <input class="edit-input" :value="formatCoef(prod.coefs[ins.idx])" @blur="updateCoef(prod, ins.idx, $event)">
              </td>
              <td class="separator"></td>
              <td v-for="ins in insumosOther" :key="ins.idx" class="insumo-other">
                <input class="edit-input" :value="formatCoef(prod.coefs[ins.idx])" @blur="updateCoef(prod, ins.idx, $event)">
              </td>
            </tr>
            
            <!-- Valor Unitário -->
            <tr class="calc-row">
              <th colspan="10">VALOR UNITÁRIO (R$)</th>
              <td class="separator"></td>
              <td v-for="ins in insumosMain" :key="ins.idx"><input class="edit-input bold" :value="formatCurrency(bottomData.valorUnitario[ins.idx])" @blur="updateBottom('valorUnitario', ins.idx, $event, true)"></td>
              <td class="separator"></td>
              <td v-for="ins in insumosOther" :key="ins.idx"><input class="edit-input bold" :value="formatCurrency(bottomData.valorUnitario[ins.idx])" @blur="updateBottom('valorUnitario', ins.idx, $event, true)"></td>
            </tr>
            
            <!-- Insumos Necessários -->
            <tr class="calc-row">
              <th colspan="10">INSUMOS NECESSÁRIOS (Selecionados)</th>
              <td class="separator"></td>
              <td v-for="ins in insumosMain" :key="ins.idx">
                <div class="bold">{{ formatNum(calcInsumosNecessarios(ins.idx)) }}</div>
                <div class="val-box">{{ formatCurrency(calcInsumosNecessarios(ins.idx) * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
                <button class="btn-calc" @click="showBreakdown(ins.idx, ins.name)">(Ver Conta)</button>
              </td>
              <td class="separator"></td>
              <td v-for="ins in insumosOther" :key="ins.idx">
                <div class="bold">{{ formatNum(calcInsumosNecessarios(ins.idx)) }}</div>
                <div class="val-box">{{ formatCurrency(calcInsumosNecessarios(ins.idx) * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
                <button class="btn-calc" @click="showBreakdown(ins.idx, ins.name)">(Ver Conta)</button>
              </td>
            </tr>
            
            <!-- Estoque Atual -->
            <tr class="calc-row">
              <th colspan="10">ESTOQUE ATUAL</th>
              <td class="separator"></td>
              <td v-for="ins in insumosMain" :key="ins.idx">
                <input class="edit-input bold" :value="formatNum(bottomData.estoqueAtual[ins.idx])" @blur="updateBottom('estoqueAtual', ins.idx, $event)">
                <div class="val-box">{{ formatCurrency(bottomData.estoqueAtual[ins.idx] * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
              <td class="separator"></td>
              <td v-for="ins in insumosOther" :key="ins.idx">
                <input class="edit-input bold" :value="formatNum(bottomData.estoqueAtual[ins.idx])" @blur="updateBottom('estoqueAtual', ins.idx, $event)">
                <div class="val-box">{{ formatCurrency(bottomData.estoqueAtual[ins.idx] * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
            </tr>
            
            <!-- Entregas Projeção FUNDEF -->
            <tr class="calc-row">
              <th colspan="10">ENTREGAS PROJEÇÃO FUNDEF</th>
              <td class="separator"></td>
              <td v-for="ins in insumosMain" :key="ins.idx">
                <input class="edit-input bold" :value="formatNum(bottomData.entregasFundef[ins.idx])" @blur="updateBottom('entregasFundef', ins.idx, $event)">
                <div class="val-box">{{ formatCurrency(bottomData.entregasFundef[ins.idx] * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
              <td class="separator"></td>
              <td v-for="ins in insumosOther" :key="ins.idx">
                <input class="edit-input bold" :value="formatNum(bottomData.entregasFundef[ins.idx])" @blur="updateBottom('entregasFundef', ins.idx, $event)">
                <div class="val-box">{{ formatCurrency(bottomData.entregasFundef[ins.idx] * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
            </tr>
            
            <!-- Complementar Demandas GOV -->
            <tr class="calc-row">
              <th colspan="10">COMPLEMENTAR DEMANDAS GOV</th>
              <td class="separator"></td>
              <td v-for="ins in insumosMain" :key="ins.idx">
                <input class="edit-input bold" :value="formatNum(bottomData.complementarDemandas[ins.idx])" @blur="updateBottom('complementarDemandas', ins.idx, $event)">
                <div class="val-box">{{ formatCurrency(bottomData.complementarDemandas[ins.idx] * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
              <td class="separator"></td>
              <td v-for="ins in insumosOther" :key="ins.idx">
                <input class="edit-input bold" :value="formatNum(bottomData.complementarDemandas[ins.idx])" @blur="updateBottom('complementarDemandas', ins.idx, $event)">
                <div class="val-box">{{ formatCurrency(bottomData.complementarDemandas[ins.idx] * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
            </tr>
            
            <!-- Estoque Total -->
            <tr class="calc-row">
              <th colspan="10">ESTOQUE TOTAL (COM PROJEÇÃO)</th>
              <td class="separator"></td>
              <td v-for="ins in insumosMain" :key="ins.idx">
                <div class="bold">{{ formatNum(calcEstoqueTotal(ins.idx)) }}</div>
                <div class="val-box">{{ formatCurrency(calcEstoqueTotal(ins.idx) * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
              <td class="separator"></td>
              <td v-for="ins in insumosOther" :key="ins.idx">
                <div class="bold">{{ formatNum(calcEstoqueTotal(ins.idx)) }}</div>
                <div class="val-box">{{ formatCurrency(calcEstoqueTotal(ins.idx) * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
            </tr>
            
            <!-- Saldo -->
            <tr class="calc-row">
              <th colspan="10">SALDO FINAL</th>
              <td class="separator"></td>
              <td v-for="ins in insumosMain" :key="ins.idx">
                <div :class="calcSaldoClass(ins.idx)">{{ formatNum(calcSaldo(ins.idx)) }}</div>
                <div class="val-box" :class="calcSaldoClass(ins.idx)">{{ formatCurrency(calcSaldo(ins.idx) * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
              <td class="separator"></td>
              <td v-for="ins in insumosOther" :key="ins.idx">
                <div :class="calcSaldoClass(ins.idx)">{{ formatNum(calcSaldo(ins.idx)) }}</div>
                <div class="val-box" :class="calcSaldoClass(ins.idx)">{{ formatCurrency(calcSaldo(ins.idx) * (bottomData.valorUnitario[ins.idx] || 0)) }}</div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- DASHBOARD RODAPÉ -->
      <div class="dashboard-footer">
        <div class="card card-pos-main">
          <h4>Saldo Positivo (Maior Relevância)</h4>
          <div class="val">{{ formatCurrency(summary.saldoPosMain) }}</div>
        </div>
        <div class="card card-neg-main">
          <h4>Saldo Negativo (Maior Relevância)</h4>
          <div class="val">{{ formatCurrency(summary.saldoNegMain) }}</div>
        </div>
        <div class="card card-pos-other">
          <h4>Saldo Positivo (Outros Insumos)</h4>
          <div class="val">{{ formatCurrency(summary.saldoPosOther) }}</div>
        </div>
        <div class="card card-neg-other">
          <h4>Saldo Negativo (Outros Insumos)</h4>
          <div class="val">{{ formatCurrency(summary.saldoNegOther) }}</div>
        </div>
      </div>

    </div>

    <!-- Modal Detalhes -->
    <div class="modal-overlay" v-if="modalInfo" @click.self="modalInfo = null">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Cálculo: {{ modalInfo.name }}</h3>
          <button class="close-btn" @click="modalInfo = null">✖</button>
        </div>
        <table class="calc-list">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Qnt. Entregar</th>
              <th>× Multiplicador</th>
              <th>= Total Insumo</th>
            </tr>
          </thead>
          <tbody>
            <tr v-for="item in modalInfo.items" :key="item.produto">
              <td>{{ item.produto }}</td>
              <td>{{ formatNum(item.qntd) }}</td>
              <td>{{ formatCoef(item.coef) }}</td>
              <td class="bold">{{ formatNum(item.total) }}</td>
            </tr>
          </tbody>
        </table>
        <div class="modal-total">TOTAL FINAL: {{ formatNum(modalInfo.totalFinal) }}</div>
      </div>
    </div>

  </div>

  <script>
    const { createApp, ref, computed, onMounted } = Vue;
    
    createApp({
      setup() {
        const loading = ref(true);
        const originalRawData = ref(null); 
        const headers = ref([]);
        const products = ref([]);
        const insumosMain = ref([]);
        const insumosOther = ref([]);
        const bottomData = ref({ valorUnitario: {}, estoqueAtual: {}, entregasFundef: {}, complementarDemandas: {} });
        const modalInfo = ref(null);
        const mostrarTodos = ref(false); 

        const parseNum = (val) => {
          if (typeof val === 'number') return val;
          if (val === null || val === undefined || val === '') return 0;
          let s = String(val).trim().replace(/[R$\s]/g, '');
          if (s.includes(',')) { s = s.replace(/\./g, '').replace(',', '.'); } 
          else if (/\.\d{3}$/.test(s)) { s = s.replace(/\./g, ''); }
          let n = parseFloat(s);
          return isNaN(n) ? 0 : n;
        };

        const formatCurrency = (val) => {
          if (!val || isNaN(val)) return 'R$ 0,00';
          return Number(val).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        };
        const formatNum = (val) => {
          if (!val || isNaN(val) || val === 0) return '0';
          return Number(val).toLocaleString('pt-BR', { maximumFractionDigits: 2 });
        };
        const formatCoef = (val) => {
          if (!val || isNaN(val) || val === 0) return '';
          return Number(val).toLocaleString('pt-BR', { maximumFractionDigits: 4 });
        };

        const processData = (data) => {
          if (!data || data.length === 0) return;
          headers.value = data[0].map(h => String(h).trim());
          products.value = []; insumosMain.value = []; insumosOther.value = [];
          bottomData.value = { valorUnitario: {}, estoqueAtual: {}, entregasFundef: {}, complementarDemandas: {} };
          
          for(let i=9; i<=16; i++) if(headers.value[i]) insumosMain.value.push({ idx: i, name: headers.value[i] });
          for(let i=18; i<headers.value.length; i++) if(headers.value[i]) insumosOther.value.push({ idx: i, name: headers.value[i] });
          
          let rowValorUnitario = 25; 
          for(let r=1; r<data.length; r++) { if(data[r].some(cell => String(cell).toUpperCase().includes('VALOR UNITÁRIO'))) { rowValorUnitario = r; break; } }
          
          let idCount = 0;
          for(let r=1; r<rowValorUnitario; r++) {
            let row = data[r];
            if(!row[0] && !row[1]) continue;
            let coefs = {};
            [...insumosMain.value, ...insumosOther.value].forEach(ins => coefs[ins.idx] = parseNum(row[ins.idx]));
            
            let initialQntd = parseNum(row[6]); 

            products.value.push({
              id: idCount++,
              selected: initialQntd > 0, 
              tipo: row[0], produto: row[1], conveniada: parseNum(row[2]), entregue: parseNum(row[3]),
              faltante: parseNum(row[4]), estoque: parseNum(row[5]), 
              qntdEntregar: initialQntd, 
              valorProduto: parseNum(row[7]), coefs: coefs
            });
          }
          
          [...insumosMain.value, ...insumosOther.value].forEach(ins => {
            bottomData.value.valorUnitario[ins.idx] = 0; bottomData.value.estoqueAtual[ins.idx] = 0;
            bottomData.value.entregasFundef[ins.idx] = 0; bottomData.value.complementarDemandas[ins.idx] = 0;
          });
          
          const getBottomRow = (keyword) => data.find(r => r.some(cell => String(cell).toUpperCase().includes(keyword)));
          let rValUnit = getBottomRow('VALOR UNITÁRIO'), rEstq = getBottomRow('ESTOQUE ATUAL'), rFundef = getBottomRow('ENTREGAS PROJEÇÃO FUNDEF'), rComp = getBottomRow('COMPLEMENTAR DEMANDAS');
          
          [...insumosMain.value, ...insumosOther.value].forEach(ins => {
            if(rValUnit) bottomData.value.valorUnitario[ins.idx] = parseNum(rValUnit[ins.idx]);
            if(rEstq) bottomData.value.estoqueAtual[ins.idx] = parseNum(rEstq[ins.idx]);
            if(rFundef) bottomData.value.entregasFundef[ins.idx] = parseNum(rFundef[ins.idx]);
            if(rComp) bottomData.value.complementarDemandas[ins.idx] = parseNum(rComp[ins.idx]);
          });
          loading.value = false;
        };

        const loadData = () => {
          loading.value = true;
          // ALTERADO para o novo endpoint de API criado no server.js
          fetch('/api/simulador')
            .then(response => response.json())
            .then(res => {
              originalRawData.value = JSON.parse(JSON.stringify(res));
              processData(res);
            })
            .catch(error => {
              console.error('Falha ao carregar dados da API:', error);
              loading.value = false;
              alert('Erro ao carregar dados da aba SIMULADOR. Verifique o console.');
            });
        };

        onMounted(() => {
          loadData();
        });

        const resetData = () => { if (originalRawData.value && confirm('Resetar para os valores originais da planilha?')) { processData(JSON.parse(JSON.stringify(originalRawData.value))); mostrarTodos.value = false; } };

        const displayedProducts = computed(() => {
          if (mostrarTodos.value) return products.value;
          return products.value.filter(p => p.qntdEntregar > 0 || p.selected);
        });

        const allSelected = computed(() => displayedProducts.value.every(p => p.selected));
        const toggleAll = (e) => { const checked = e.target.checked; displayedProducts.value.forEach(p => p.selected = checked); };

        const calcValorTotalProduto = (prod) => prod.selected ? (prod.qntdEntregar * (prod.valorProduto || 0)) : 0;
        const calcInsumosNecessarios = (insIdx) => { return products.value.filter(p => p.selected).reduce((sum, prod) => sum + (prod.qntdEntregar * (prod.coefs[insIdx] || 0)), 0); };
        const calcEstoqueTotal = (insIdx) => (bottomData.value.estoqueAtual[insIdx] || 0) + (bottomData.value.entregasFundef[insIdx] || 0) + (bottomData.value.complementarDemandas[insIdx] || 0);
        const calcSaldo = (insIdx) => calcEstoqueTotal(insIdx) - calcInsumosNecessarios(insIdx);
        const calcSaldoClass = (insIdx) => { const s = calcSaldo(insIdx); return s < 0 ? 'saldo-neg' : (s > 0 ? 'saldo-pos' : ''); };

        const summary = computed(() => {
          let posMain = 0, negMain = 0, posOther = 0, negOther = 0;
          insumosMain.value.forEach(ins => { 
            const s = calcSaldo(ins.idx); const vu = bottomData.value.valorUnitario[ins.idx] || 0; 
            if (s > 0) posMain += (s * vu); else if (s < 0) negMain += (Math.abs(s) * vu); 
          });
          insumosOther.value.forEach(ins => { 
            const s = calcSaldo(ins.idx); const vu = bottomData.value.valorUnitario[ins.idx] || 0; 
            if (s > 0) posOther += (s * vu); else if (s < 0) negOther += (Math.abs(s) * vu); 
          });
          return { saldoPosMain: posMain, saldoNegMain: negMain, saldoPosOther: posOther, saldoNegOther: negOther, saldoPosTotal: posMain + posOther, aSolicitarTotal: negMain + negOther };
        });

        const showBreakdown = (insIdx, insName) => {
          const items = products.value.filter(p => p.selected).map(p => {
            const q = p.qntdEntregar, c = p.coefs[insIdx] || 0;
            return { produto: p.produto || 'Sem Nome', qntd: q, coef: c, total: q * c };
          }).filter(item => item.total > 0);
          modalInfo.value = { name: insName, items: items, totalFinal: items.reduce((sum, i) => sum + i.total, 0) };
        };

        const updateField = (obj, field, event, isCurrency = false) => { const val = parseNum(event.target.value); obj[field] = val; event.target.value = isCurrency ? formatCurrency(val) : formatNum(val); };
        const updateCoef = (prod, insIdx, event) => { const val = parseNum(event.target.value); prod.coefs[insIdx] = val; event.target.value = formatCoef(val); };
        const updateBottom = (field, insIdx, event, isCurrency = false) => { const val = parseNum(event.target.value); bottomData.value[field][insIdx] = val; event.target.value = isCurrency ? formatCurrency(val) : formatNum(val); };

        return {
          loading, headers, products, displayedProducts, mostrarTodos, insumosMain, insumosOther, bottomData, modalInfo, summary, allSelected,
          formatNum, formatCurrency, formatCoef, calcValorTotalProduto, calcInsumosNecessarios, calcEstoqueTotal, calcSaldo, calcSaldoClass,
          updateField, updateCoef, updateBottom, showBreakdown, resetData, toggleAll
        };
      }
    }).mount('#app');
  </script>
</body>
</html>